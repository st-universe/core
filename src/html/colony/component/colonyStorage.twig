<table class="use" style="width: 433px;">
    <tr>
        <th>
            <span>Lager:</span> {{ STORAGE_SUM }}/{{ MAX_STORAGE }}
            ({{ STORAGE_SUM_PERCENT }}%)
        </th>
        <td>
            {% autoescape false %}
            {{ PRODUCTION_SUM|formatProductionValue }}
            {% endautoescape %}
        </td>
    </tr>
    {% for stor in STORAGE %}
    <tr class="row">
        <td style="vertical-align: middle;">
            {% include 'html/storage/storageItem.twig' with {
                'storageItem': stor.storage,
                'commodity': stor.commodity,
                'showName': true,
                'locations': true
            } only %}
        </td>
        <td style="vertical-align: {{ stor.storage and stor.storage.hasImprovedModules ? 'top' : 'middle' }};">
            {% if stor.production %}
            <span class="{{ stor.production.getCssClass }}">{{ stor.production.getProductionDisplay }}</span>
            {% else %}
            -
            {% endif %}
        </td>
    </tr>
    {% endfor %}
</table>
