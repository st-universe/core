{% set crew = CREW_ASSIGNMENT.getCrew %}
{% set crewId = crew.getId %}
{% set crewImageType = CREW_ASSIGNMENT.getCrewImageType %}
{% set isForeignCrew = crew.getUser.getId != SHIP.getUser.getId %}
{% set canRemoveCrew = isForeignCrew and (SHIP.getUser.getId == USER_ID or crew.getUser.getId == USER_ID) %}
<tr>
    <td{% if crew.getUser.getId == USER_ID %} class="crew-assignment-detail-link"
        onclick="switchInnerContent('SHOW_CREWMAN_DETAILS', 'Crewman Details', 'id={{ crewId }}&sstr={{ SESSIONSTRING }}', '/ship.php');"{% endif %}>
        <img src="assets/crew/{{ crew.getRace.getGfxPath }}/{{ crew.getGenderShort }}/1_{{ crewImageType }}.png" />
        {% if canRemoveCrew %}
        <a href="?B_DUMP_CREWMAN=1&id={{ SHIP.getId }}&crewid={{ crewId }}&sstr={{ SESSIONSTRING }}"
            onclick="event.stopPropagation();"
            onmouseover="cp('dump_{{ crewId }}','buttons/x2')"
            onmouseout="cp('dump_{{ crewId }}','buttons/x1')">
            <img src="/assets/buttons/x2.png" name="dump_{{ crewId }}" title="Crewman entfernen" />
        </a>
        {% endif %}
    </td>
    <td{% if crew.getUser.getId == USER_ID %} class="crew-assignment-detail-link"
        onclick="switchInnerContent('SHOW_CREWMAN_DETAILS', 'Crewman Details', 'id={{ crewId }}&sstr={{ SESSIONSTRING }}', '/ship.php');"{% endif %}>
        <div>{{ CREW_RANK_NAMES[crewId] }}</div>
    </td>
    <td style="vertical-align: middle;">
        {% set CREW = crew %}
        {% include 'html/ship/crew/crewSlot.twig' %}
    </td>
    <td{% if crew.getUser.getId == USER_ID %} class="crew-assignment-detail-link"
        onclick="switchInnerContent('SHOW_CREWMAN_DETAILS', 'Crewman Details', 'id={{ crewId }}&sstr={{ SESSIONSTRING }}', '/ship.php');"{% endif %}>
        <div>{{ CREW_ASSIGNMENT.getSlot ? CREW_ASSIGNMENT.getSlot.getDescription : 'Crewman' }}</div>
    </td>
</tr>
{% if isForeignCrew %}
<tr>
    <td colspan="4" style="text-align: left;">{{ crew.getUser.getName|bbcode }}</td>
</tr>
{% endif %}
