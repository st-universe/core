<table class="use" style="width: 250px;">
  <tr>
    <th>
      <img onClick="window.scrollTo(0,0);" src="/assets/buttons/lager.png" title="Lagerraum" /> Lagerraum
      {{ SPACECRAFT.getStorageSum }}/{{ SPACECRAFT.getMaxStorage }}
    </th>
  </tr>
  <tr>
    <td>
      <div class="spacecraft-storage-items" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px 0; align-items: start;">
        {% for commodity in SPACECRAFT.getStorage %}
        {% if commodity.getAmount %}
        {% include 'html/storage/storageItem.twig' with {
          'storageItem': commodity,
          'commodity': commodity.getCommodity,
          'showName': false,
          'locations': false
        } only %}
        {% endif %}
        {% endfor %}
      </div>
    </td>
  </tr>
</table>
