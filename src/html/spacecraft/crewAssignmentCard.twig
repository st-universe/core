{% set crew = assignment.getCrew %}
{% set crewImageType = assignment.getCrewImageType %}
{% set isReadOnly = CREW_ASSIGNMENT_READONLY is defined ? CREW_ASSIGNMENT_READONLY : false %}
{% set showSkills = SHOW_CREW_SKILLS is defined ? SHOW_CREW_SKILLS : true %}
{% set showOwnerInfo = (SHOW_CREW_OWNER_INFO is defined ? SHOW_CREW_OWNER_INFO : false) and crew.getUser.getId != SPACECRAFT.getUser.getId %}
{% set rankName = CREW_RANK_NAMES[crew.getId]|default(CREW_RANK_NAMES[crew.getRank.value]|default('')) %}
<div class="crew-assignment-card{% if isReadOnly %} crew-assignment-card-readonly{% endif %}"
    {% if not isReadOnly %}
    draggable="true" data-crew-id="{{ crew.getId }}" data-crew-slot="{{ assignment.getSlot.value }}"
    ondragstart="startCrewAssignmentDrag(event, this);"
    ondragend="endCrewAssignmentDrag(this);"
    ondragover="allowCrewAssignmentSwap(event, this);"
    ondragleave="leaveCrewAssignmentSwap(event, this);"
    ondrop="dropCrewAssignmentOnCard(event, this);"
    onpointerdown="setCrewAssignmentPointerType(this, event.pointerType);"
    onclick="selectCrewAssignmentForTouch(event, this);"
    {% endif %}>
    <div class="crew-assignment-card-main">
        <img src="/assets/crew/{{ crew.getRace.getGfxPath }}/{{ crew.getGenderShort }}/1_{{ crewImageType }}.png" />
        <div>
            <div class="crew-assignment-name">{{ crew.getName|bbcode }}</div>
            <div>{{ rankName }}</div>
        </div>
    </div>
    {% if showOwnerInfo %}
    <div class="crew-assignment-owner">{{ crew.getUser.getName|bbcode }} ({{ crew.getUser.getId }})</div>
    {% elseif showSkills %}
    {% if crew.getSkills|length > 0 %}
    <div class="crew-assignment-skills">
        {% for skill in crew.getSkills %}
        <span>{{ skill.getPosition.getDescription }}: {{ skill.getExpertise }} XP</span>
        {% endfor %}
    </div>
    {% else %}
    <div class="crew-assignment-no-skills">Noch keine Erfahrung</div>
    {% endif %}
    {% endif %}
</div>
