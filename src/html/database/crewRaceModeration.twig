{% macro raceInfo(crewRace, entry) %}
<dl class="crew-race-facts">
    <div><dt>Definition</dt><dd>{{ crewRace.getGfxPath }}</dd></div>
    <div><dt>Zufallsrate</dt><dd>{{ crewRace.getChance }}</dd></div>
    <div><dt>Männeranteil</dt><dd>{{ crewRace.getMaleRatio }} %</dd></div>
    <div><dt>Zivil</dt><dd>{{ crewRace.isCivil ? 'Ja' : 'Nein' }}</dd></div>
    <div><dt>Freigabe</dt><dd>{{ crewRace.isShared ? 'Mit anderen teilen' : 'Nur eigene Nutzung' }}</dd></div>
    <div><dt>Fraktionen</dt><dd>{{ entry.getFactionNames }}</dd></div>
</dl>
{% endmacro %}
{% macro graphics(crewRace) %}
{% set positionNames = {
    1: 'Kommandoposten (Kommandierender Offizier und 1. Offizier)',
    2: 'Taktik',
    3: 'Wissenschaft',
    4: 'Technik',
    5: 'Navigation',
    6: 'Crewman'
} %}
{% if crewRace.getMaleRatio > 0 %}
<div>Männlich: {% for imageType, positionName in positionNames %}<span class="crew-race-graphic-preview"><img src="{{ crewRace.getImagePath('m', imageType) }}" title="{{ positionName }}" alt="{{ positionName }}" /></span>{% endfor %}</div>
{% endif %}
{% if crewRace.getMaleRatio < 100 %}
<div>Weiblich: {% for imageType, positionName in positionNames %}<span class="crew-race-graphic-preview"><img src="{{ crewRace.getImagePath('w', imageType) }}" title="{{ positionName }}" alt="{{ positionName }}" /></span>{% endfor %}</div>
{% endif %}
{% endmacro %}
{% macro editor(crewRace, factions, isAdmin, session) %}
<form action="database.php" method="post" style="margin-top: 8px;">
    <input type="hidden" name="sstr" value="{{ session }}" />
    <input type="hidden" name="crew_race_id" value="{{ crewRace.getId }}" />
    <div class="crew-race-fields">
        <label>Rassenname<input class="text" type="text" name="crew_race_name" maxlength="255" value="{{ crewRace.getDescription }}" required="required" /></label>
        <label>Grafikdefinition<input class="text" type="text" name="crew_race_define" maxlength="255" value="{{ crewRace.getGfxPath }}" required="required" /></label>
        {% if isAdmin %}
        <label>Zufallsrate<input class="text" type="number" name="crew_race_chance" min="1" max="100" value="{{ crewRace.getChance }}" required="required" /></label>
        <label>Männeranteil (%)<input class="text" type="number" name="crew_race_male_ratio" min="0" max="100" value="{{ crewRace.getMaleRatio }}" required="required" /></label>
        <div><label><input type="checkbox" name="crew_race_civil" value="1"{% if crewRace.isCivil %} checked="checked"{% endif %} />Zivil</label></div>
        <div class="crew-race-choice"><label><input type="radio" name="crew_race_shared" value="0"{% if not crewRace.isShared %} checked="checked"{% endif %} />Nicht teilen</label><label><input type="radio" name="crew_race_shared" value="1"{% if crewRace.isShared %} checked="checked"{% endif %} />Mit anderen teilen</label></div>
        <div class="crew-race-factions" style="grid-column: 1 / -1;">{% for faction in factions %}<label><input type="checkbox" name="crew_race_factions[]" value="{{ faction.getId }}"{% if faction.getId in crewRace.getFactionIds %} checked="checked"{% endif %} />{{ faction.getName }}</label>{% endfor %}</div>
        {% endif %}
    </div>
    <input type="submit" class="button" style="margin-top: 8px;" name="B_UPDATE_CREW_RACE_MODERATION" value="Änderungen speichern" />
</form>
{% endmacro %}
{% import _self as crewRaceMacros %}

<div class="crew-race-moderation">
    {% for section in [
        {title: 'Offene Crew-Rassen', entries: PENDING_CREW_RACES, status: 'pending', empty: 'Keine offenen Einreichungen vorhanden'},
        {title: 'Akzeptierte Crew-Rassen', entries: ACCEPTED_CREW_RACES, status: 'accepted', empty: 'Keine akzeptierten benutzererstellten Crew-Rassen vorhanden'},
        {title: 'Abgelehnte Crew-Rassen', entries: REJECTED_CREW_RACES, status: 'rejected', empty: 'Keine abgelehnten benutzererstellten Crew-Rassen vorhanden'}
    ] %}
    <section style="margin-bottom: 16px;">
        <div class="divhead">{{ section.title }} ({{ section.entries|length }})</div>
        <div class="divbody crew-race-cards">
            {% for entry in section.entries %}
            {% set crewRace = entry.getCrewRace %}
            <article style="min-width: 0; border: 1px solid var(--color-53);">
                <div class="divhead" style="overflow-wrap: anywhere;">{{ crewRace.getDescription }} von {{ entry.getCreatorName|bbcode }}</div>
                <div style="display: grid; gap: 10px; padding: 10px;">
                    {{ crewRaceMacros.raceInfo(crewRace, entry) }}
                    <div class="crew-race-previews">{{ crewRaceMacros.graphics(crewRace) }}</div>
                    {% if crewRace.getRejectionReason %}
                    <div><strong>Ablehnungsgrund:</strong><div class="crew-race-reason">{{ crewRace.getRejectionReason }}</div></div>
                    {% endif %}
                    {% if IS_ADMIN or section.status == 'pending' %}
                    <details>
                        <summary style="cursor: pointer;">Einstellungen bearbeiten</summary>
                        {{ crewRaceMacros.editor(crewRace, PLAYABLE_FACTIONS, IS_ADMIN, SESSIONSTRING) }}
                    </details>
                    {% endif %}
                    {% if section.status == 'pending' %}
                    <form action="database.php" method="post" class="crew-race-decision">
                        <input type="hidden" name="sstr" value="{{ SESSIONSTRING }}" />
                        <input type="hidden" name="crew_race_id" value="{{ crewRace.getId }}" />
                        <input type="hidden" name="B_MODERATE_CREW_RACE" value="1" />
                        <label for="rejection-reason-{{ crewRace.getId }}">Kommentar zur Ablehnung (optional)</label>
                        <textarea id="rejection-reason-{{ crewRace.getId }}" class="text" style="resize: vertical;" name="rejection_reason" rows="2" maxlength="2000" placeholder="Was muss vor einer erneuten Einreichung geändert werden?"></textarea>
                        <div class="crew-race-choice">
                            <button class="button" type="submit" name="decision" value="accept">Akzeptieren</button>
                            <button class="button" type="submit" name="decision" value="reject">Ablehnen</button>
                        </div>
                    </form>
                    {% endif %}
                </div>
            </article>
            {% else %}
            <div>{{ section.empty }}</div>
            {% endfor %}
        </div>
    </section>
    {% endfor %}
</div>
