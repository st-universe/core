<div style="{{ SURFACETILESTYLE }}">
    {% for field in SURFACE %}
    <div style="margin: 1px; width: 42px; height: 42px;" class="{{ CSSCLASS }}">
        <div
            style="background-image: url(assets/generated/fields/t{{ field.type_id }}.png); width: 40px; height: 40px;">
            <div>
                {% set buildingId = field.buildings_id|default(field.id|default(null)) %}
                {% if buildingId %}
                {% set storedRotation = field.rotation|default(0) %}
                {% set rotation = storedRotation is same as(90) or storedRotation is same as('90') ? 90
                    : (storedRotation is same as(180) or storedRotation is same as('180') ? 180
                    : (storedRotation is same as(270) or storedRotation is same as('270') ? 270 : 0)) %}
                <img style="width: 40px; height: 40px;"
                    src="assets/generated/buildings/{{ buildingId }}/{{ rotation }}at.png" />
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>
