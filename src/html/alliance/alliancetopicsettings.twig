<form action="alliance.php" method="post">
    <input type="hidden" name="sstr" value="{{ SESSIONSTRING }}" />
    <input type="hidden" name="boardid" value="{{ TOPIC.getBoardId }}" />
    <input type="hidden" name="topicid" value="{{ TOPIC.getId }}" />
    <table class="use" style="width: 200px">
        <tr>
            <td>
                <a href="?B_DELETE_TOPIC=1&topicid={{ TOPIC.getId }}&boardid={{ TOPIC.getBoardId }}&sstr={{ SESSIONSTRING }}"
                    class="linkbutton">Thema löschen</a>
                <br />
                <br />
                <br />
                <input type="text" style="width: 100%" name="tname" value="{{ TOPIC.getName }}" /><br />
                <br />
                <input type="submit" value="Umbenennen" name="B_RENAME_TOPIC" />
                <br />
                <br />
                {% if not TOPIC.getSticky %}
                <button type="submit" class="linkbutton" name="B_SET_STICKY" value="1">Als Wichtig markieren</button>
                {% else %}
                <button type="submit" class="linkbutton" name="B_UNSET_STICKY" value="1">Als Unwichtig markieren</button>
                {% endif %}
            </td>
        </tr>
    </table>
</form>
