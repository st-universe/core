<table class="tcal">
    {% set rump = SELECTOR.getRump %}
    {% set type = SELECTOR.getModuleType.value %}
    {% set allowMultiple = SELECTOR.allowMultiple %}
    <input type="hidden" name="module_level_{{ type }}" value="{{ SELECTOR.getModuleTypeLevel }}" />
    {% if SELECTOR.getAvailableModules %}
    {% set normalModules = [] %}
    {% set npcModules = [] %}

    {% for entry in SELECTOR.getAvailableModules %}
    {% if entry.getModule.getisNpc == true %}
    {% set npcModules = npcModules|merge([entry]) %}
    {% else %}
    {% set normalModules = normalModules|merge([entry]) %}
    {% endif %}
    {% endfor %}

    <tr>
        {% set colspan = allowMultiple ? 2 : 3 %}
        <th colspan="{{ colspan }}">Modulbezeichnung</th>
        <th>benötigte Crew</th>
        <th>lagernd</th>
        <th>Auswirkungen</th>
    </tr>
    {% if SELECTOR.allowEmptySlot %}
    <tr>
        <td></td>
        {% set colspan = allowMultiple ? 4 : 5 %}
        <td colspan="{{ colspan }}">
            <input type="radio"{% if SELECTOR.isEmptySlot %} checked="true"{% endif %} name="mod_{{ type }}[]" value="0" onchange="replaceTabImage({{ type }}, 0);" />
            <span>Keine Auswahl</span>
        </td>
    </tr>
    {% endif %}
    {% for moduleSelectorEntry in normalModules %}
    {% include 'html/ship/construction/moduleSelector/selectorEntry.twig' %}
    {% endfor %}
    {% if npcModules|length > 0 %}
    <tr>
        {% set colspan = allowMultiple ? 5 : 6 %}
        <th colspan="{{ colspan }}" style="text-align: center;">NPC Module</th>
    </tr>
    {% for moduleSelectorEntry in npcModules %}
    {% include 'html/ship/construction/moduleSelector/selectorEntry.twig' %}
    {% endfor %}
    {% endif %}
    {% else %}
    <tr>
        <td>Keine Module dieses Typs installierbar</td>
    </tr>
    {% endif %}
</table>
