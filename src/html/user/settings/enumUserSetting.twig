{% set currentValue = setting.getCurrentValue %}
<select name="{{ setting.getParameterName }}">
    {% if setting.getType.isNullable %}
    <option value="0">----------------------</option>
    {% endif %}
    {% for enum in setting.getPossibleValues %}
    {% set selected = currentValue == enum ? 'selected="1"' : '' %}
    <option value="{{ enum.value }}" {{ selected }}>
        {{ enum.getTitle }}
    </option>
    {% endfor %}
</select>
{% if setting.getType.value == 'css_color_sheet' %}
{% set assimilationEnabled = BORG_ASSIMILATION_ENABLED is not defined or BORG_ASSIMILATION_ENABLED %}
<button type="submit" name="B_CHANGE_BORG_ASSIMILATION" value="{{ assimilationEnabled ? 'disable' : 'enable' }}" class="button">
    {{ assimilationEnabled ? 'Deassimilieren' : 'Reassimilieren' }}
</button>
{% endif %}
