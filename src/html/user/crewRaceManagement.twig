<div class="crew-race-management" id="crew-race-management" data-session-string="{{ SESSIONSTRING }}">
    <table class="tcal">
        <tr>
            <th colspan="4">Ausgewählte Crew-Rassen</th>
        </tr>
        <tr>
            <th>Name</th>
            <th>Grafiken</th>
            <th>Zufallsrate</th>
            <th>Zuordnung</th>
        </tr>
        {% for crewRace in SELECTABLE_CREW_RACES|default([]) %}
        {% set userCrewRace = USER_CREW_RACES[crewRace.getId]|default(null) %}
        {% set genderCount = crewRace.getMaleRatio > 0 and crewRace.getMaleRatio < 100 ? 2 : 1 %}
        {% for gender, label in {'m': 'Männlich', 'w': 'Weiblich'} %}
        {% if (gender == 'm' and crewRace.getMaleRatio > 0) or (gender == 'w' and crewRace.getMaleRatio < 100) %}
        {% set isFirstGender = gender == 'm' or crewRace.getMaleRatio == 0 %}
        <tr data-crew-race-id="{{ crewRace.getId }}">
            {% if isFirstGender %}
            <td rowspan="{{ genderCount }}">
                {{ crewRace.getDescription }}
                {% if crewRace.getCreatorUserId is not null %}
                <br />von {{ CREW_RACE_OWNER_NAMES[crewRace.getId]|default('Niemand')|bbcode }} ({{ crewRace.getCreatorUserId }})
                {% endif %}
            </td>
            {% endif %}
            <td>
                {{ label }}
                {% for imageType, position in {1: 'Kommandoposten', 2: 'Taktik', 3: 'Wissenschaft', 4: 'Technik', 5: 'Navigation', 6: 'Crewman'} %}
                <img src="{{ crewRace.getImagePath(gender, imageType) }}" alt="{{ position }} {{ label }}" title="{{ position }} {{ label }}" />
                {% endfor %}
            </td>
            {% if isFirstGender %}
            <td rowspan="{{ genderCount }}">
                {% if userCrewRace %}
                <input class="text crew-race-chance" type="number" min="1" max="100" value="{{ userCrewRace.getChance ?? crewRace.getChance }}" />
                <button class="button crew-race-action" type="button" data-action="save">Speichern</button>
                {% endif %}
            </td>
            <td rowspan="{{ genderCount }}">
                {% if userCrewRace %}
                <button class="button crew-race-action" type="button" data-action="remove">X</button>
                {% else %}
                <button class="button crew-race-action" type="button" data-action="select">Auswählen</button>
                {% endif %}
            </td>
            {% endif %}
        </tr>
        {% endif %}
        {% endfor %}
        {% else %}
        <tr><td colspan="4">Keine Crew-Rassen verfügbar</td></tr>
        {% endfor %}
    </table>
    <br />

    <table class="tcal">
        <tr>
            <th colspan="5">Meine Crew-Rassen</th>
        </tr>
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Männeranteil</th>
            <th>Freigabe</th>
            <th>Fraktionen</th>
        </tr>
        {% for crewRace in OWN_CREW_RACES %}
        <tr>
            <td>{{ crewRace.getDescription }}</td>
            <td>
                {{ crewRace.getStatus }}
                {% if crewRace.isRejected %}
                <form action="options.php" method="post">
                    <input type="hidden" name="crew_race_id" value="{{ crewRace.getId }}" />
                    <button class="button" type="submit" name="SHOW_CREW_RACE_MANAGEMENT" value="1">Erneut einreichen</button>
                </form>
                {% endif %}
            </td>
            <td>{{ crewRace.getMaleRatio }} %</td>
            <td>{{ crewRace.isShared ? 'Mit anderen teilen' : 'Nur eigene Nutzung' }}</td>
            <td>
                {% for faction in PLAYABLE_FACTIONS %}
                {% if faction.getId in crewRace.getFactionIds %}{{ faction.getName }}{% if not loop.last %}, {% endif %}{% endif %}
                {% endfor %}
            </td>
        </tr>
        {% if crewRace.isRejected and crewRace.getRejectionReason %}
        <tr><td colspan="5"><strong>Ablehnungsgrund:</strong><div class="crew-race-reason">{{ crewRace.getRejectionReason }}</div></td></tr>
        {% endif %}
        {% if crewRace.canEditDistribution %}
        <tr>
            <td colspan="5">
                <form action="options.php" method="post">
                    <input type="hidden" name="sstr" value="{{ SESSIONSTRING }}" />
                    <input type="hidden" name="crew_race_id" value="{{ crewRace.getId }}" />
                    <div class="crew-race-choice">
                        {% if crewRace.isShared %}
                        Mit anderen Spielern teilen
                        {% else %}
                        <label><input type="checkbox" name="crew_race_shared" value="1" />Mit anderen Spielern teilen</label>
                        {% endif %}
                    </div>
                    <div class="crew-race-factions">
                        {% for faction in PLAYABLE_FACTIONS %}
                        <label><input type="checkbox" name="crew_race_factions[]" value="{{ faction.getId }}"{% if faction.getId in crewRace.getFactionIds %} checked="checked" disabled="disabled"{% endif %} />{{ faction.getName }}</label>
                        {% endfor %}
                    </div>
                    <input type="submit" class="button" name="B_UPDATE_CREW_RACE_DISTRIBUTION" value="Freigaben speichern" />
                </form>
            </td>
        </tr>
        {% endif %}
        {% else %}
        <tr>
            <td colspan="5">Du hast noch keine Crew-Rasse eingereicht</td>
        </tr>
        {% endfor %}
    </table>
    <br />

    {% if CAN_CREATE_CREW_RACE or EDIT_CREW_RACE %}
    <form id="crew-race-form" action="options.php" method="post" enctype="multipart/form-data">
        {% if EDIT_CREW_RACE %}<input type="hidden" name="crew_race_id" value="{{ EDIT_CREW_RACE.getId }}" />{% endif %}
        <input type="hidden" name="sstr" value="{{ SESSIONSTRING }}" />
        <table class="tcal">
            <tr>
                <th colspan="2">{{ EDIT_CREW_RACE ? 'Crew-Rasse überarbeiten und erneut einreichen' : 'Neue Crew-Rasse einreichen' }}</th>
            </tr>
            {% if CREW_RACE_CREATION_REMAINING is not null and not EDIT_CREW_RACE %}
            <tr>
                <td colspan="2">Du kannst noch {{ CREW_RACE_CREATION_REMAINING }} eigene Crew-Rasse{% if CREW_RACE_CREATION_REMAINING != 1 %}n{% endif %} einreichen</td>
            </tr>
            {% endif %}
            {% if EDIT_CREW_RACE and EDIT_CREW_RACE.getRejectionReason %}
            <tr><td>Ablehnungsgrund</td><td class="crew-race-reason">{{ EDIT_CREW_RACE.getRejectionReason }}</td></tr>
            {% endif %}
            <tr>
                <td>Name</td>
                <td><input class="text" type="text" id="crew-race-name" name="crew_race_name" maxlength="255" value="{{ FORM_CREW_RACE_NAME }}" required="required" /></td>
            </tr>
            <tr>
                <td>Grafikdefinition</td>
                <td>
                    <input class="text" type="text" id="crew-race-define" name="crew_race_define" maxlength="255" value="{{ FORM_CREW_RACE_DEFINE }}" required="required" />
                    <div>Technischer Ordnername für die Grafiken, nur Großbuchstaben und einzelne Unterstriche</div>
                </td>
            </tr>
            <tr>
                <td>Männeranteil</td>
                <td><input class="text" type="number" name="crew_race_male_ratio" min="0" max="100" value="{{ FORM_CREW_RACE_MALE_RATIO }}" required="required" /> %</td>
            </tr>
            <tr>
                <td>Zufallsrate</td>
                <td><input class="text" type="number" name="crew_race_chance" min="1" max="100" value="{{ FORM_CREW_RACE_CHANCE }}" required="required" /><div>Legt fest, wie häufig diese Crew-Rasse im Verhältnis zu anderen Crew-Rassen erzeugt wird</div></td>
            </tr>
            <tr>
                <td>Zivil</td>
                <td><label><input type="checkbox" name="crew_race_civil" value="1"{% if FORM_CREW_RACE_CIVIL %} checked="checked"{% endif %} />Als zivile Crew verwendbar</label></td>
            </tr>
            <tr>
                <td>Mit anderen teilen</td>
                <td class="crew-race-choice">
                    <label><input type="radio" name="crew_race_shared" value="0"{% if not FORM_CREW_RACE_SHARED %} checked="checked"{% endif %} />Nein</label>
                    <label><input type="radio" name="crew_race_shared" value="1"{% if FORM_CREW_RACE_SHARED %} checked="checked"{% endif %} />Ja</label>
                </td>
            </tr>
            <tr>
                <td>Fraktionen</td>
                <td class="crew-race-factions">
                    {% for faction in PLAYABLE_FACTIONS %}
                    <label><input type="checkbox" name="crew_race_factions[]" value="{{ faction.getId }}"{% if faction.getId == OWN_FACTION_ID %} checked="checked" disabled="disabled"{% elseif faction.getId in FORM_CREW_RACE_FACTION_IDS %} checked="checked"{% endif %} />{{ faction.getName }}</label>
                    {% endfor %}
                    <div>Weitere Fraktionen werden nur berücksichtigt, wenn die Crew-Rasse geteilt wird</div>
                </td>
            </tr>
            <tr>
                <td>Grafiken</td>
                <td>
                    <div>Nur PNG-Dateien mit exakt 51x52 Pixeln und höchstens 10 KB pro Grafik. Bei Fehlern müssen Dateien erneut ausgewählt werden</div>
                    <div>Der Hintergrund sollte transparent sein. Verwende positionsspezifische Rahmen: Rot für Navigation und die Kommandoposten, Grau für Crewman, Gelb für Taktik und Technik sowie Blau für Wissenschaft. Die Gestaltung soll neutral, einfach grafisch und an den bestehenden Crew-Grafiken orientiert sein. Fotorealistische oder unpassende Motive können abgelehnt werden</div>
                    {% if EDIT_CREW_RACE %}<p>Vorhandene Grafiken bleiben erhalten. Wähle nur für die Positionen neue Dateien aus, die du ersetzen möchtest. Für neu benötigte Geschlechter sind alle sechs Grafiken erforderlich</p>{% endif %}
                    {% for gender, label in {'m': 'Männlich', 'w': 'Weiblich'} %}
                    <fieldset class="crew-race-graphics">
                        <legend>{{ label }}{% if gender == 'm' %} (bei Männeranteil 0 % nicht erforderlich){% else %} (bei Männeranteil 100 % nicht erforderlich){% endif %}</legend>
                        {% for imageType, position in {1: 'Kommandoposten', 2: 'Taktik', 3: 'Wissenschaft', 4: 'Technik', 5: 'Navigation', 6: 'Crewman'} %}
                        <label class="crew-race-upload">
                            <span>{{ position }}</span>
                            {% if EDIT_CREW_RACE and ((gender == 'm' and EDIT_CREW_RACE.getMaleRatio > 0) or (gender == 'w' and EDIT_CREW_RACE.getMaleRatio < 100)) %}
                            <span class="crew-race-graphic-preview"><img src="{{ EDIT_CREW_RACE.getImagePath(gender, imageType) }}" alt="{{ position }} {{ label }}" /></span>
                            {% endif %}
                            <input type="file" name="crew_graphics[{{ gender }}][{{ imageType }}]" accept="image/png" />
                        </label>
                        {% endfor %}
                    </fieldset>
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <td colspan="2"><input type="submit" class="button" name="{{ EDIT_CREW_RACE ? 'B_RESUBMIT_CREW_RACE' : 'B_CREATE_CREW_RACE' }}" value="{{ EDIT_CREW_RACE ? 'Erneut einreichen' : 'Crew-Rasse einreichen' }}" />{% if EDIT_CREW_RACE %} <button class="button" type="submit" form="crew-race-cancel" name="SHOW_CREW_RACE_MANAGEMENT" value="1">Abbrechen</button>{% endif %}</td>
            </tr>
        </table>
        <script>
            (() => {
                const name = document.getElementById('crew-race-name');
                const define = document.getElementById('crew-race-define');
                if (define.value) define.dataset.edited = '1';
                const normalizeDefine = (value) => value
                    .replaceAll('Ä', 'AE')
                    .replaceAll('Ö', 'OE')
                    .replaceAll('Ü', 'UE')
                    .replaceAll('ä', 'AE')
                    .replaceAll('ö', 'OE')
                    .replaceAll('ü', 'UE')
                    .replaceAll('ß', 'SS')
                    .replace(/\s+/g, '_')
                    .toUpperCase()
                    .replace(/[^A-Z_]/g, '')
                    .replace(/_+/g, '_')
                    .replace(/^_+|_+$/g, '');

                name.addEventListener('input', () => {
                    if (define.dataset.edited !== '1') {
                        define.value = normalizeDefine(name.value);
                    }
                });
                define.addEventListener('input', () => {
                    define.dataset.edited = '1';
                    define.value = normalizeDefine(define.value);
                });
            })();
        </script>
    </form>
    {% if EDIT_CREW_RACE %}<form id="crew-race-cancel" action="options.php" method="post"></form>{% endif %}
    {% endif %}
</div>
