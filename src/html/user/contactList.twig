{% from 'html/macros.twig' import pmWindow, userProfile %}

<form action="pm.php" method="post" name="contactlist" id="contactlist">
	<input type="hidden" name="SHOW_CONTACTLIST" value="1" />
	<input type="hidden" name="sstr" value="{{ SESSIONSTRING }}" />
	<input type="hidden" id="formaction" value="1" />
	<input type="hidden" name="edit_contact" id="edit_contact" value="0" />
	<input type="hidden" name="deletion_mark" id="deletion_mark" value="" />
	<input type="hidden" name="contact_permission_id" id="contact_permission_id" value="0" />
	<input type="hidden" name="contact_permissions" id="contact_permissions" value="0" />
	<input type="hidden" name="ur" id="user_relation_permission_id" value="0" />
	<input type="hidden" name="relation_permissions" id="user_relation_permissions" value="0" />
	<div style="float: left; width: 75%;">
		{% for contact in CONTACT_LIST %}
		{% set contactId = contact.getId %}
		<table class="tcal">
			<tr class="row">
				<td style="width: 20px; text-align: center;">
					<input type="checkbox" name="deleted[]" value="{{ contactId }}" />
				</td>
				<td style="width: 60px;">
					<span id="contact{{ contactId }}">
						{% set div = 'contact' ~ contactId %}
						{% include 'html/user/contactMode.twig' %}
					</span>
				</td>

				<td>
					{% set recipientId = contact.getRecipient.getId %}
					{{ pmWindow(USER, recipientId) }}
					{{ userProfile(recipientId) }}
					{{ contact.getRecipient.getName|bbcode }} ({{ recipientId }})
				</td>
				<td style="width: 16px;">
					{% if not contact.getComment %}
					<img src="assets/buttons/b_down1.png" title="Kommentar"
						onclick="toggleTableRowVisible('contact_comment_{{ contactId }}')" />
					{% endif %}
				</td>
			</tr>
			<tr>
				<td colspan="4">
					<span class="crew-management-filters">
						<label>
							<input id="contact_live_map_{{ contactId }}" type="checkbox" {% if contact.hasPermission(LIVE_MAP_PERMISSION) %}checked="checked"{% endif %} />
							Schiffspositionen auf der Live-Karte teilen
						</label>
					</span>
					<input type="button" class="button" value="speichern" data-save-contact-permissions data-contact-id="{{ contactId }}" />
				</td>
			</tr>
			{% if contact.getComment %}
			{% set style = '' %}
			{% else %}
			{% set style = 'display: none' %}
			{% endif %}
			<tr style="{{ style }}" id="contact_comment_{{ contactId }}">
				<td colspan="4">
					<span>Kommentar</span>
					<input type="text" style="width: 500px" name="comment_{{ contactId }}"
						id="contact_comment_input_{{ contactId }}" value="{{ contact.getComment }}" />
					<input type="button" class="button" value="speichern"
						onclick="saveContactComment({{ contactId }})" />
					<input type="button" class="button" value="löschen"
						onclick="emptyContactComment({{ contactId }})" />
				</td>
			</tr>
		</table>
		<br />
		{% endfor %}
		{% if SHOW_USER_RELATIONS and USER_RELATIONS %}
		<br /><br />
		<table class="tcal">
			<tr>
				<th colspan="5">Abkommen</th>
			</tr>
			<tr>
				<td class="darkbg">Vertragspartei</td>
				<td class="darkbg">Abkommen</td>
				<td class="darkbg">Zeitpunkt</td>
				<td class="darkbg">Rechte</td>
				<td class="darkbg">Aktionen</td>
			</tr>
			{% for relation in USER_RELATIONS %}
			<tr class="row{{ loop.index0 % 2 }}">
				<td>{{ relation.getCounterpartName(USER)|bbcode }}</td>
				<td>{{ relation.getType.getDescription }}</td>
				<td>{% if not relation.isPending %}{{ relation.getDate|stuDateTime }}{% endif %}</td>
				<td>
					{% if not relation.hasPermissions %}
					Keine Rechte
					{% else %}
					{% for permission in RELATION_PERMISSIONS %}
					{% if relation.hasPermission(permission) %}{{ permission.getDescription }}<br />{% endif %}
					{% endfor %}
					{% endif %}
				</td>
				<td>
					{% if relation.isPending %}
						{% if relation.isSourceParty(USER) and CAN_MANAGE_USER_RELATIONS %}
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_CANCEL_USER_RELATION=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Zurückziehen</a>
						{% elseif CAN_MANAGE_USER_RELATIONS %}
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_ACCEPT_USER_RELATION=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Annehmen</a>
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_DECLINE_USER_RELATION=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Ablehnen</a>
						{% else %}
						Wurde angeboten
						{% endif %}
					{% elseif relation.hasPendingPermissionChanges %}
						{% if relation.isPermissionChangeOfferedBy(USER) and CAN_MANAGE_USER_RELATIONS %}
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_CANCEL_USER_RELATION=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Rechteänderung zurückziehen</a>
						{% elseif CAN_MANAGE_USER_RELATIONS %}
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_ACCEPT_USER_RELATION=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Rechteänderung annehmen</a>
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_DECLINE_USER_RELATION=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Rechteänderung ablehnen</a>
						{% endif %}
					{% elseif CAN_MANAGE_USER_RELATIONS %}
						{% if relation.isWar %}
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_SUGGEST_USER_RELATION_PEACE=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Frieden vorschlagen</a>
						{% else %}
						<a class="linkbutton" href="pm.php?SHOW_CONTACTLIST=1&B_CANCEL_USER_RELATION=1&ur={{ relation.getId }}&sstr={{ SESSIONSTRING }}">Vertrag lösen</a>
						<span id="user-relation-permissions-{{ relation.getId }}" class="crew-management-filters">
							{% for permission in RELATION_PERMISSIONS %}
							{% if permission.isAvailableFor(relation.getType) %}
							<label>
								<input type="checkbox" value="{{ permission.value }}" data-relation-permission {% if relation.hasPermission(permission) %}checked="checked"{% endif %} />
								{{ permission.getDescription }}
							</label>
							{% endif %}
							{% endfor %}
						</span>
						<input type="button" class="button" value="Rechte ändern" data-propose-user-relation-permissions data-relation-id="{{ relation.getId }}" />
						{% endif %}
					{% else %}
					Keine Aktionen verfügbar
					{% endif %}
				</td>
			</tr>
			{% endfor %}
		</table>
		{% endif %}
		{% if REMOTE_CONTACTS %}
		<br /><br />
		<table class="tcal">
			<tr>
				<th colspan="2">Einträge anderer Siedler über Dich</th>
			</tr>
			{% for contact in REMOTE_CONTACTS %}
			{% set contactId = contact.getId %}
			<tr class="row">
				<td style="width: 60px;">
					<span id="contact{{ contactId }}">
						{% set div = false %}
						{% include 'html/user/contactMode.twig' %}
					</span>
				</td>
				<td>
					{{ contact.getUser.getName|bbcode }} ({{ contact.getUser.getId }})
					{% if contact.hasPermission(LIVE_MAP_PERMISSION) %}
					<br />Teilt Schiffspositionen auf der Live-Karte
					{% endif %}
				</td>
			</tr>
			{% endfor %}
		</table>
		{% endif %}
	</div>
	<div style="float: left; padding-left: 1%; width: 24%;">
		<table class="tcal">
			<tr>
				<th>Hinzufügen</th>
			</tr>
			<tr>
				<td>
					Siedler ID <input type="text" style="width: 50px;" name="recid" />
					{% set divname = 'clmode' %}
					{% include 'html/user/contactListModeSelector.twig' %}
					<input type="submit" value="Hinzufügen" name="B_ADD_CONTACT" />
				</td>
			</tr>
		</table>
		{% if SHOW_USER_RELATIONS and CAN_CREATE_USER_RELATIONS %}
		<br />
		<table class="tcal">
			<tr>
				<th>Abkommen anbieten</th>
			</tr>
			<tr>
				<td>
					<label for="contact-relation-target-type">Abkommen mit</label>
					<select id="contact-relation-target-type" name="relation_target_type">
						<option value="1">Siedler</option>
						<option value="2">Allianz</option>
					</select>
					<span id="contact-user-relation-target">
						<label for="contact-user-relation-target-id">Siedler-ID</label>
						<input id="contact-user-relation-target-id" type="text" style="width: 50px;" name="relation_target" />
					</span>
					<span id="contact-alliance-relation-target" style="display: none;">
						<label for="contact-alliance-relation-target-id">Allianz</label>
						<select id="contact-alliance-relation-target-id" name="relation_target" disabled>
							{% for alliance in ALLIANCE_LIST %}
							<option value="{{ alliance.getId }}">{{ alliance.getName|bbcode2txt }}</option>
							{% endfor %}
						</select>
					</span>
					<select id="contact-relation-type" name="relation_type" data-relation-permission-selector="contact-relation-permissions">
						{% for type in POSSIBLE_USER_RELATION_TYPES %}
						<option value="{{ type.value }}">{{ type.getDescription }}</option>
						{% endfor %}
					</select>
					<input id="contact-relation-permissions" type="hidden" name="relation_permissions" value="0" />
					<span class="crew-management-filters" data-relation-permissions="contact-relation-permissions" style="display: none;">
						{% for permission in RELATION_PERMISSIONS %}
						<label data-relation-permission-types="{% if permission.value == 1 %}3,4,5,6{% else %}4{% endif %}" style="display: none;">
							<input type="checkbox" value="{{ permission.value }}" data-relation-permission />
							{{ permission.getDescription }}
						</label>
						{% endfor %}
					</span>
					<input type="submit" value="Anbieten" name="B_CREATE_USER_RELATION" />
				</td>
			</tr>
		</table>
		{% endif %}
		<br />
		<table class="tcal">
			<tr>
				<th>Aktionen</th>
			</tr>
			<tr>
				<td>
					<span style="color: #cecece">&gt;</span> <a href="javascript:void(0);"
						onclick="markAllContacts();">Alle selektieren</a>
					<br />
					<span style="color: #cecece">&gt;</span> <a href="javascript:void(0);"
						onclick="unMarkAllContacts();">Alle deselektieren</a>
					<br /><br />
					<span style="color: #cecece">&gt;</span> <a href="javascript:void(0);"
						onclick="deleteMarkedContacts();">Alle selektierten löschen</a>
					<br /><br />
					<span style="color: #cecece">&gt;</span> <a href="javascript:void(0);"
						onClick="actionToInnerContent('B_DELETE_ALL_CONTACTS', 'sstr={{ SESSIONSTRING }}');">
						Alle löschen</a>
				</td>
			</tr>
		</table>
	</div>
</form>
